{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": ["./node_modules/@types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@medml/ui": ["./lib/ui/src"],
      "@medml/store": ["./lib/store/src"],
      "@medml/patients": ["./domains/patients/src"],
      "@medml/auth": ["./domains/auth/src"],
      "@medml/layout": ["./domains/layout/src"],
      "@medml/shared": ["./lib/shared/src"],
      "@medml/viewers": ["./lib/viewers/src"]
    }
  },
  "exclude": ["node_modules"]
}

