{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@medml/ui": ["../../lib/ui/src"],
      "@medml/store": ["../../lib/store/src"],
      "@medml/patients": ["../../domains/patients/src"],
      "@medml/patient_list": ["../../domains/patient_list/src"],
      "@medml/auth": ["../../domains/auth/src"],
      "@medml/layout": ["../../domains/layout/src"],
      "@medml/shared": ["../../lib/shared/src"],
      "@medml/viewers": ["../../lib/viewers/src"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}


