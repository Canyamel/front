{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@/api/*": ["./src/api/*"],
      "@/features/*": ["./src/features/*"],
      "@medml/ui": ["../../lib/ui/src"],
      "@medml/store": ["../../lib/store/src"],
      "@medml/patient_list": ["../../domains/patient_list/src"],
      "@medml/patient_create": ["../../domains/patient_create/src"],
      "@medml/doctor_profile": ["../../domains/doctor_profile/src"],
      "@medml/patient_view": ["../../domains/patient_view/src"],
      "@medml/auth": ["../../domains/auth/src"],
      "@medml/layout": ["../../domains/layout/src"],
      "@medml/shared": ["../../lib/shared/src"],
      "@medml/subscriptions": ["../../domains/subscriptions/src"],
      "@medml/viewers": ["../../lib/viewers/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules"]
}
