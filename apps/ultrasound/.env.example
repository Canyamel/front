# База API для fetch (в dev проксируется через Vite — см. vite.config.ts)
VITE_API_BASE_URL=http://10.164.2.11:8080/api/v1

# Новый основной URL для доступа к бэкенду
VITE_BACKEND_BASE_URL=http://localhost:5173/api/v3

# Старый alias для совместимости (можно оставить закомментированным)
# VITE_API_BASE_URL=http://localhost:5173/api/v3

# Куда проксировать `/api` в dev (внутренний адрес бэкенда / Nginx)
VITE_BACKEND_PROXY_TARGET=http://localhost:5173

# Куда проксировать `/api` в dev (бэкенд)
VITE_ULTRASOUND_PROXY_TARGET=http://10.164.2.11:8080

# Если на бэкенде есть свой endpoint проверки токена — включите:
# VITE_SESSION_CHECK=true
# VITE_SESSION_PATH=/users/me/
