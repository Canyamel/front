# Production / Docker: относительные пути, nginx проксирует location /api.
#
# Сейчас настроено на Go-шлюз (composition-api).

# Префикс публикации (см. build/nginx.conf.template). От него зависят адреса
# ассетов, роутер и адреса API: /uzi/api/v1/...
VITE_BASE_PATH=/uzi/

VITE_API_BACKEND=med
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_BASE_URL=/api/v1

# Обновление токена: у Go-шлюза ручка называется /refresh и ждёт
# `refresh_token` в теле. Django-вариант — /auth/token/refresh/ с токеном
# в заголовке, он же стоит по умолчанию в коде.
VITE_AUTH_REFRESH_PATH=/refresh

# Вариант для Django (thyroid).

# VITE_API_BACKEND=thyroid
# VITE_API_BASE_URL=/api/v3
# VITE_BACKEND_BASE_URL=/api/v3
# VITE_AUTH_REFRESH_PATH=/auth/token/refresh/
