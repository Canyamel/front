# Какой бэкенд обслуживает цитологию и тайлер:
#   python — прежний Django-сервис + отдельный DZI-сервис
#   go     — composition-api, единый шлюз (см. cmd/service/server.yml)
VITE_CYTOLOGY_BACKEND=python

# ─── python ───────────────────────────────────────────────
# API v3 (как OLD-PROJECTS/CYTO)
VITE_CYTOLOGY_PROXY_TARGET=http://msa.mephi.ru:7000
VITE_API_BASE_URL=/api/v3

# DZI tiler (отдельный сервис, не med_ml v1)
VITE_DZI_PROXY_TARGET=http://msa.mephi.ru:8005
VITE_DZI_API_BASE_URL=/api/bid/v1/dzi

# JWT refresh (OLD: token в заголовке)
VITE_AUTH_REFRESH_PATH=/auth/token/refresh/
VITE_AUTH_REFRESH_HEADER_TOKEN=true

# ─── go ───────────────────────────────────────────────────
# Для go-режима достаточно переключить флаг: база, прокси, путь refresh
# и адрес тайлера подставятся сами (vite.config.ts). Значения ниже —
# те, что получатся по умолчанию; переопределяйте только при нужде.
#
# VITE_CYTOLOGY_BACKEND=go
# VITE_CYTOLOGY_PROXY_TARGET=http://localhost:8080
# VITE_API_BASE_URL=/api/v1
# VITE_AUTH_REFRESH_PATH=/refresh
# VITE_AUTH_REFRESH_HEADER_TOKEN=false
