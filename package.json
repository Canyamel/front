{
  "name": "medml-front",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "lib/*",
    "domains/*"
  ],
  "scripts": {
    "dev:cytology": "turbo dev --filter=cytology-app",
    "build:cytology": "turbo build --filter=cytology-app",
    "dev:uzi": "turbo run dev --filter=uzi-app",
    "build:uzi": "turbo run build --filter=uzi-app",
    "start:uzi": "turbo run start --filter=uzi-app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.0.1",
    "@reduxjs/toolkit": "^2.0.0",
    "antd": "^5.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.1.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "sass": "^1.83.0",
    "turbo": "^1.13.4",
    "typescript-eslint": "^8.53.0"
  }
}
