# Один nginx на оба фронта: цитология и УЗИ.
#
# Разведены по портам. Порты обходятся без правок в коде.
#
#   80 — цитология
#   81 — УЗИ
#
# Про переменные в `proxy_pass`: адрес подставляется через `set`, а не
# литералом. С литеральным именем nginx резолвит апстрим при старте и падает с
# `host not found in upstream`, если контейнер бэкенда ещё не поднят — фронт
# тогда не запускается вовсе, хотя статику мог бы отдавать. С переменной резолв
# откладывается до запроса. Платить приходится тем, что исходный путь nginx
# больше не подставляет сам, поэтому он дописан явно через `$request_uri`.

server {
    listen 80;
    server_name _;

    client_max_body_size 0;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # Встроенный DNS Docker — нужен из-за переменных в proxy_pass.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Чанковая загрузка .svs.
    #
    # Обслуживается отдельным Node-сервисом (services/cytology-upload): у шлюза
    # таких ручек нет, а в разработке их поднимает плагин dev-сервера Vite.
    # Блок обязан идти раньше общего `/api`, иначе запросы уйдут на бэкенд.
    location /api/upload {
        set $upload_backend ${UPLOAD_BACKEND_URL};
        proxy_pass $upload_backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Файл целиком не буферизуем: он может быть на несколько гигабайт.
        proxy_request_buffering off;
    }

    location /api/bid {
        set $dzi_backend ${DZI_BACKEND_URL};
        proxy_pass $dzi_backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        set $api_backend ${API_BACKEND_URL};
        proxy_pass $api_backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html/cytology;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 81;
    server_name _;

    client_max_body_size 0;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Биллинг живёт только в Go-шлюзе и адресуется по /api/v1 независимо от
    # того, на какой бэкенд смотрит остальное приложение. Поэтому отдельный
    # блок, и он должен идти раньше общего `/api`.
    location /api/v1 {
        set $uzi_billing_backend ${UZI_BILLING_BACKEND_URL};
        proxy_pass $uzi_billing_backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        set $uzi_api_backend ${UZI_API_BACKEND_URL};
        proxy_pass $uzi_api_backend$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        root /usr/share/nginx/html/ultrasound;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
